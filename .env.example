# Copie ce fichier en ".env" puis remplis les valeurs. Ne publie JAMAIS ton .env (il est dans .gitignore).

# Clé de signature des sessions : génère-la avec  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Adresse publique de l'appli (en local : http://localhost:5000)
APP_URL=http://localhost:5000
# Mettre 1 en production derrière HTTPS
SECURE_COOKIES=0

# Liaison Google Business Profile (voir README, étape « Connecter Google »)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optionnel : réponses rédigées par Claude au lieu du moteur de règles
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
