# Copie ce fichier en .env et remplis les valeurs. Ne partage JAMAIS le fichier .env.

# 1 = développement sur ton PC, 0 = production (HTTPS obligatoire)
DEBUG=1

# Obligatoires en production. Génère-les avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
FIELD_ENCRYPTION_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# PostgreSQL en production (laisser vide pour SQLite en développement)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Google Business Profile (après validation de ton accès par Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiement Stripe — clés de TEST (sk_test_…) tant que tu développes.
# Tableau de bord Stripe → Développeurs → Clés API ; Webhooks → endpoint https://ton-site/stripe/webhook/
# avec les événements : checkout.session.completed, customer.subscription.*, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Produits → un prix mensuel récurrent par formule (identifiants price_…)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# IA (Claude). Sans clé : moteur de règles intégré.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
